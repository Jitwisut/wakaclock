{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AtoAxis Desktop",
  "version": "0.1.0",
  "identifier": "com.atoaxis.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AtoAxis Desktop",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Private foreground-app activity tracking for AtoAxis"
  }
}
