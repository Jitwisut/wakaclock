{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/warn-dead-backend.sh\"",
            "timeout": 10,
            "statusMessage": "Checking backend module reachability"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/warn-wrong-dir.sh\"",
            "timeout": 10,
            "statusMessage": "Checking build directory"
          }
        ]
      }
    ]
  }
}
