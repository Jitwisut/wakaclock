{
  "name": "shadcn-ui-kit",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "build": "next build",
    "indexnow:submit": "node scripts/indexnow-submit.mjs",
    "build:analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "validate": "run-p typecheck lint:strict test:run",
    "check:strict": "node scripts/check-strict.mjs",
    "check:prerender": "node scripts/check-prerender.mjs",
    "check:build": "npm run build && npm run check:prerender",
    "check:all": "run-s check:strict storybook:build storybook:audit storybook:deep-gaps storybook:test:a11y test:e2e",
    "validate:ci": "run-p typecheck lint:strict && npm run test:ci",
    "storybook": "storybook dev -p 6006",
    "storybook:ci": "storybook dev -p 6006 --no-open",
    "storybook:build": "cross-env NODE_NO_WARNINGS=1 storybook build",
    "storybook:audit": "node scripts/storybook-audit.mjs",
    "storybook:deep-gaps": "node scripts/storybook-deep-gaps.mjs",
    "storybook:baseline": "node scripts/storybook-component-baseline.mjs",
    "storybook:meta-baseline": "node scripts/storybook-meta-baseline.mjs",
    "storybook:playfill": "node scripts/storybook-add-default-play.mjs",
    "storybook:playfill:upgrade": "node scripts/storybook-upgrade-playfill.mjs",
    "storybook:playfill:downgrade": "node scripts/storybook-downgrade-playfill.mjs",
    "storybook:playfill:strengthen": "node scripts/storybook-strengthen-playfill.mjs",
    "storybook:gaps": "node scripts/storybook-gaps.mjs",
    "storybook:quality": "node scripts/storybook-quality.mjs",
    "storybook:fullread": "node scripts/storybook-fullread.mjs .storybook",
    "storybook:test": "start-server-and-test storybook:ci http://127.0.0.1:6006 \"test-storybook --no-cache\"",
    "storybook:test:a11y": "cross-env STORYBOOK_RUN_A11Y=1 npm run storybook:test",
    "storybook:a11y:baseline": "rimraf .storybook/.a11y-baseline && cross-env STORYBOOK_RUN_A11Y=1 STORYBOOK_A11Y_MODE=collect npm run storybook:test && node scripts/storybook-a11y-baseline.mjs",
    "chromatic": "node scripts/run-chromatic.mjs",
    "repo:fullread": "node scripts/repo-fullread.mjs .",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "madge": "node scripts/madge-circular.mjs",
    "madge:verbose": "cross-env MADGE_SHOW_SKIPPED=1 node scripts/madge-circular.mjs",
    "clean": "rimraf .next node_modules/.cache coverage test-results playwright-report",
    "clean:all": "rimraf .next node_modules coverage test-results playwright-report .storybook-static build dist",
    "release": "semantic-release",
    "prepare": "lefthook install",
    "postinstall": "patch-package"
  },
