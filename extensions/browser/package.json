{
  "name": "atoaxis-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "npm run typecheck && npm test && npm run build && npm run check:package",
    "package": "npm run build && node scripts/package.mjs",
    "safari:project": "npm run build && node scripts/safari-project.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "lint:firefox": "addons-linter dist/firefox --output text --warnings-as-errors",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/webextension-polyfill": "^0.12.0",
    "addons-linter": "^10.13.0",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
