{
  "name": "atoaxis-vscode",
  "displayName": "AtoAxis — Developer Time Tracking",
  "description": "Developer time tracking for VS Code with AI agent attribution. Install, add your AtoAxis API key, and start tracking.",
  "version": "0.1.0",
  "publisher": "atoaxis",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/Jitwisut/wakaclock#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jitwisut/wakaclock.git"
  },
  "bugs": {
    "url": "https://github.com/Jitwisut/wakaclock/issues"
  },
  "keywords": [
    "time tracking",
    "coding time",
    "developer productivity",
    "analytics",
    "activity tracking",
    "programming",
    "self-hosted",
    "metrics"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "main": "./out/src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:wakaclock.configureCliPath",
    "onCommand:wakaclock.showToday",
    "onCommand:wakaclock.setupAiTracking",
    "onCommand:wakaclock.showAiTrackingStatus",
    "onCommand:wakaclock.showBrokerStatus",
    "onCommand:wakaclock.repairAiIntegrations",
    "onCommand:wakaclock.testAiDetection",
    "workspaceContains:**/*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "wakaclock.configureCliPath",
        "title": "Wakaclock: Configure CLI Path"
      },
      {
        "command": "wakaclock.showToday",
        "title": "Wakaclock: Show Today's Total"
      },
      {
        "command": "wakaclock.sendHeartbeatNow",
        "title": "Wakaclock: Send Heartbeat Now"
      },
      {
        "command": "wakaclock.toggleStatusBar",
        "title": "Wakaclock: Toggle Status Bar"
      },
      {
        "command": "wakaclock.setApiKey",
        "title": "Wakaclock: Set API Key"
      },
      {
        "command": "wakaclock.clearApiKey",
        "title": "Wakaclock: Clear API Key"
      },
      {
        "command": "wakaclock.setupAiTracking",
        "title": "AtoAxis: Set Up AI Tracking"
      },
      {
        "command": "wakaclock.showAiTrackingStatus",
        "title": "AtoAxis: Show AI Tracking Status"
      },
      {
        "command": "wakaclock.showBrokerStatus",
        "title": "AtoAxis: Show AI Broker Status"
      },
      {
        "command": "wakaclock.repairAiIntegrations",
        "title": "AtoAxis: Repair AI Integrations"
      },
      {
        "command": "wakaclock.testAiDetection",
        "title": "AtoAxis: Test AI Detection"
      }
    ],
    "configuration": {
      "title": "Wakaclock",
      "properties": {
        "wakaclock.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Advanced development override for the wakaclock binary. Leave empty to use the bundled, verified CLI. Workspace values are ignored."
        },
        "wakaclock.serverUrl": {
          "type": "string",
          "default": "https://api.atoaxis.com",
          "scope": "window",
          "description": "Advanced global server-origin override. Production users should keep https://api.atoaxis.com; workspace values are ignored."
        },
        "wakaclock.flushIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "How often the extension checks buffered file activity. Heartbeats are rate-limited separately."
        },
        "wakaclock.heartbeatRateLimitSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 30,
          "description": "Strict activity window and minimum non-write heartbeat cadence in seconds. Gaps above 120 seconds never add time."
        },
        "wakaclock.sameFileHeartbeatMinutes": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "description": "Deprecated compatibility setting. Use wakaclock.heartbeatRateLimitSeconds."
        },
        "wakaclock.idleMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "description": "Deprecated compatibility setting. Activity timing always uses the fixed 120-second strict gap."
        },
        "wakaclock.statusBarEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show today's total coding time in the VS Code status bar."
        },
        "wakaclock.debugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose Wakaclock logging in the extension host console."
        },
        "wakaclock.trackDebugSessions": {
          "type": "boolean",
          "default": true,
          "description": "Send debugging heartbeats when VS Code debug sessions start and stop."
        },
        "wakaclock.trackBuildTasks": {
          "type": "boolean",
          "default": true,
          "description": "Send building heartbeats when VS Code tasks start and stop."
        },
        "wakaclock.trackClipboardActions": {
          "type": "boolean",
          "default": true,
          "description": "Track metadata-only copy and paste counts. Clipboard contents are never stored or sent."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit -p ./",
    "test": "vitest run",
    "build:resources": "node scripts/copy-ai-agents.js",
    "package:target": "node scripts/package-target.js",
    "generate:cli-manifest": "node scripts/generate-cli-manifest.js",
    "vscode:prepublish": "npm run compile && npm run build:resources"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
