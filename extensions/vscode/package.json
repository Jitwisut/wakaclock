{
  "name": "atoaxis-vscode",
  "displayName": "AtoAxis \u2014 Developer Time Tracking",
  "description": "WakaTime-compatible coding time tracking with AI-agent attribution. Invite-only Early Access: requires an AtoAxis API key.",
  "version": "0.2.0",
  "publisher": "atoaxis",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#177044",
    "theme": "dark"
  },
  "preview": true,
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://www.atoaxis.com",
  "bugs": {
    "url": "https://www.atoaxis.com/contact"
  },
  "keywords": [
    "time tracking",
    "time tracker",
    "coding time",
    "wakatime",
    "wakatime alternative",
    "ai",
    "ai attribution",
    "claude code",
    "codex",
    "gemini cli",
    "developer productivity",
    "analytics",
    "activity tracking",
    "metrics"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./out/src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:wakaclock.configureCliPath",
    "onCommand:wakaclock.showToday",
    "onCommand:wakaclock.setupAiTracking",
    "onCommand:wakaclock.showAiTrackingStatus",
    "onCommand:wakaclock.manageAiSources",
    "onCommand:wakaclock.showBrokerStatus",
    "onCommand:wakaclock.repairAiIntegrations",
    "onCommand:wakaclock.testAiDetection",
    "workspaceContains:**/*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "wakaclock.configureCliPath",
        "title": "AtoAxis: Configure CLI Path"
      },
      {
        "command": "wakaclock.showToday",
        "title": "AtoAxis: Show Today's Total"
      },
      {
        "command": "wakaclock.sendHeartbeatNow",
        "title": "AtoAxis: Send Heartbeat Now"
      },
      {
        "command": "wakaclock.toggleStatusBar",
        "title": "AtoAxis: Toggle Status Bar"
      },
      {
        "command": "wakaclock.setApiKey",
        "title": "AtoAxis: Set API Key"
      },
      {
        "command": "wakaclock.clearApiKey",
        "title": "AtoAxis: Clear API Key"
      },
      {
        "command": "wakaclock.setupAiTracking",
        "title": "AtoAxis: Set Up AI Tracking"
      },
      {
        "command": "wakaclock.showAiTrackingStatus",
        "title": "AtoAxis: Show AI Tracking Status"
      },
      {
        "command": "wakaclock.manageAiSources",
        "title": "AtoAxis: Manage AI Log Sources"
      },
      {
        "command": "wakaclock.showBrokerStatus",
        "title": "AtoAxis: Show AI Broker Status"
      },
      {
        "command": "wakaclock.repairAiIntegrations",
        "title": "AtoAxis: Repair AI Integrations"
      },
      {
        "command": "wakaclock.testAiDetection",
        "title": "AtoAxis: Test AI Detection"
      },
      {
        "command": "wakaclock.runtimePause",
        "title": "AtoAxis: Pause Runtime"
      },
      {
        "command": "wakaclock.runtimeResume",
        "title": "AtoAxis: Resume Runtime"
      },
      {
        "command": "wakaclock.rollbackManagedCli",
        "title": "AtoAxis: Roll Back Managed CLI"
      },
      {
        "command": "wakaclock.upgradeManagedCli",
        "title": "AtoAxis: Upgrade Managed CLI"
      },
      {
        "command": "wakaclock.retryJournalRejection",
        "title": "AtoAxis: Retry Retained Editor Record"
      },
      {
        "command": "wakaclock.manageRuntime",
        "title": "AtoAxis: Manage Background Runtime"
      },
      {
        "command": "wakaclock.setupNativeActivity",
        "title": "AtoAxis: Configure Native Activity Hooks"
      },
      {
        "command": "wakaclock.inspectJournal",
        "title": "AtoAxis: Inspect Journal"
      },
      {
        "command": "wakaclock.prepareJournalRecovery",
        "title": "AtoAxis: Prepare Journal Recovery"
      },
      {
        "command": "wakaclock.applyJournalRecovery",
        "title": "AtoAxis: Apply Journal Recovery"
      },
      {
        "command": "wakaclock.acknowledgeJournalHistory",
        "title": "AtoAxis: Acknowledge Incomplete Journal History"
      },
      {
        "command": "wakaclock.refreshJournalRecovery",
        "title": "AtoAxis: Refresh Journal Recovery Evidence"
      },
      {
        "command": "wakaclock.journalRecoveryHistory",
        "title": "AtoAxis: Journal Recovery History"
      },
      {
        "command": "wakaclock.setupRooTracking",
        "title": "AtoAxis: Set Up Roo Task Tracking"
      },
      {
        "command": "wakaclock.confirmRooProject",
        "title": "AtoAxis: Confirm Roo Task Project"
      },
      {
        "command": "wakaclock.inspectRooTracking",
        "title": "AtoAxis: Inspect Roo Capture"
      }
    ],
    "configuration": {
      "title": "AtoAxis",
      "properties": {
        "wakaclock.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Advanced development override for the wakaclock binary. Leave empty to use the bundled, verified CLI. Workspace values are ignored."
        },
        "wakaclock.serverUrl": {
          "type": "string",
          "default": "https://api.atoaxis.com",
          "scope": "window",
          "description": "Advanced global server-origin override. Production users should keep https://api.atoaxis.com; workspace values are ignored."
        },
        "wakaclock.flushIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "How often the extension checks buffered file activity. Heartbeats are rate-limited separately."
        },
        "wakaclock.heartbeatRateLimitSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 30,
          "description": "Minimum non-write heartbeat delivery cadence in seconds. This controls network delivery only; Active coding evidence uses a fixed 15-second lease."
        },
        "wakaclock.sameFileHeartbeatMinutes": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "description": "Deprecated compatibility setting. Use wakaclock.heartbeatRateLimitSeconds."
        },
        "wakaclock.idleMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "description": "Deprecated compatibility setting. Activity timing always uses the fixed 15-second Active lease."
        },
        "wakaclock.statusBarEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show today's total coding time in the VS Code status bar."
        },
        "wakaclock.debugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose AtoAxis logging in the extension host console."
        },
        "wakaclock.trackDebugSessions": {
          "type": "boolean",
          "default": true,
          "description": "Send debugging heartbeats when VS Code debug sessions start and stop."
        },
        "wakaclock.trackBuildTasks": {
          "type": "boolean",
          "default": true,
          "description": "Send building heartbeats when VS Code tasks start and stop."
        },
        "wakaclock.trackClipboardActions": {
          "type": "boolean",
          "default": true,
          "description": "Track metadata-only copy and paste counts. Clipboard contents are never stored or sent."
        },
        "wakaclock.autoInstallAgentHooks": {
          "type": "boolean",
          "default": true,
          "description": "Offer one-time consent to install metadata-only hooks for detected AI tools. Turning this off stops automatic setup; existing hooks are not removed."
        },
        "wakaclock.presenceAutoJoinEnabled": {
          "type": "boolean",
          "default": false,
          "description": "While coding, periodically appear as active in your team's coworking presence room even when the AtoAxis dashboard tab isn't open. Off by default because it makes your activity visible to teammates without an explicit join."
        },
        "wakaclock.rooTrackingEnabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Opt in to Roo 3.53.0 public task markers. Project attribution requires explicit task confirmation; live certification is pending."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit -p ./",
    "test": "vitest run",
    "build:resources": "node scripts/copy-ai-agents.js && node scripts/generate-ai-bundle-manifest.js resources/ai-agents",
    "package:target": "node scripts/package-target.js",
    "generate:cli-manifest": "node scripts/generate-cli-manifest.js",
    "vscode:prepublish": "npm run compile && npm run build:resources"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
