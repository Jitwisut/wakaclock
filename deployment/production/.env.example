# AtoAxis production environment for deployment/production/compose.yaml.
# Copy to `.env` in this directory (git-ignored) and fill the <...> values from the
# secret store. Never commit real values. Variable reference: .context/environment.md.
#
# Time-counting settings (IDLE_TIMEOUT_MINUTES, AGENT_IDLE_TIMEOUT_MINUTES,
# DURATION_CALCULATION_MODE, DURATION_PRIMARY_MODE) are intentionally absent: leave
# them at the defaults documented in backend/api/.env.production.example. The
# counting baseline is locked (.context/heartbeat-safety.md).

# --- API -----------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
JWT_SECRET=<openssl rand -hex 32>
CORS_ORIGINS=https://atoaxis.com,https://www.atoaxis.com
ATOAXIS_APP_URL=https://www.atoaxis.com
ATOAXIS_KMS_KEY_ID=<kms-or-vault-key-id>

# --- Managed data stores ------------------------------------------------------
# The ClickHouse database must already exist; the server does not create it.
CLICKHOUSE_URL=https://<clickhouse-host>:8443
CLICKHOUSE_USER=<clickhouse-user>
CLICKHOUSE_PASSWORD=<clickhouse-password>
CLICKHOUSE_DB=wakaclock
POSTGRES_URL=postgres://<user>:<password>@<postgres-host>:5432/<database>?sslmode=require
POSTGRES_MAX_CONNECTIONS=20
REDIS_URL=rediss://:<password>@<redis-host>:6380
PRESENCE_V2_ENABLED=true
# Accept editor line metrics; while off, clients retain line corrections as pending.
ATOAXIS_EDITOR_LINE_METRICS_ENABLED=true

# --- Kafka (always on) --------------------------------------------------------
ATOAXIS_EVENT_BUS_URL=<broker-1:9092>,<broker-2:9092>
ATOAXIS_EVENT_BUS_SASL_MECHANISM=SCRAM-SHA-512
ATOAXIS_EVENT_BUS_SASL_USERNAME=<kafka-user>
ATOAXIS_EVENT_BUS_SASL_PASSWORD=<kafka-password>
ATOAXIS_EVENT_BUS_TLS=true

# Heartbeat ingest through Kafka. `kafka` needs PostgreSQL ingest state, populated
# once by ingest-state-backfill before the first switch (README.md, stage 0).
# During rollout use `verify`, then a percent cohort; the end state is below.
ATOAXIS_INGEST_MODE=kafka
ATOAXIS_INGEST_KAFKA_COHORT=all
ATOAXIS_INGEST_STATE_SOURCE=postgres

# AI usage ingest through Kafka (also requires PostgreSQL and the job queue).
ATOAXIS_AI_USAGE_INGEST_MODE=kafka
ATOAXIS_AI_USAGE_KAFKA_COHORT=all

# --- RabbitMQ (always on) -----------------------------------------------------
ATOAXIS_JOB_QUEUE_URL=amqps://<user>:<password>@<rabbitmq-host>:5671/<vhost>
ATOAXIS_REPROCESS_MODE=job
ATOAXIS_PROJECTION_REBUILD_MODE=job
ATOAXIS_EXPORT_MODE=job
ATOAXIS_ACCOUNT_DELETION_MODE=job

# --- S3 object store (required by export and account-deletion job modes) -------
ATOAXIS_OBJECT_STORE_S3_ENDPOINT=https://s3.<region>.amazonaws.com
ATOAXIS_OBJECT_STORE_S3_BUCKET=<bucket>
ATOAXIS_OBJECT_STORE_S3_REGION=<region>
ATOAXIS_OBJECT_STORE_S3_ACCESS_KEY=<access-key>
ATOAXIS_OBJECT_STORE_S3_SECRET_KEY=<secret-key>
ATOAXIS_OBJECT_STORE_S3_PATH_STYLE=false
