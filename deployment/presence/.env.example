# Rust API process (do not put the secret in frontend env)
PRESENCE_V2_ENABLED=true
POSTGRES_URL=postgres://atoaxis:YOUR_PASSWORD@localhost:5432/atoaxis
REDIS_URL=redis://localhost:6379
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_INTERNAL_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=local-presence-development-secret-change-before-deploy

# Next.js process; rebuild/restart after changing CSP
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
