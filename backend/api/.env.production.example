# Copy these names into the managed API/worker environment. Never commit values.
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
CLICKHOUSE_URL=https://<managed-clickhouse-host>:8443
CLICKHOUSE_USER=<clickhouse-user>
CLICKHOUSE_PASSWORD=<clickhouse-password>
CLICKHOUSE_DB=wakaclock
POSTGRES_URL=postgres://<user>:<password>@<managed-postgres-host>:5432/atoaxis
POSTGRES_MAX_CONNECTIONS=32
REDIS_URL=rediss://:<password>@<managed-redis-host>:6380
PRESENCE_V2_ENABLED=true
# Accept editor line metrics (editor-before-after-v1). While off, clients retain
# line-measurement corrections locally and report delivery as incomplete.
ATOAXIS_EDITOR_LINE_METRICS_ENABLED=true
JWT_SECRET=<generate-with-openssl-rand-hex-32>
CORS_ORIGINS=https://atoaxis.com,https://www.atoaxis.com
ATOAXIS_APP_URL=https://atoaxis.com
IDLE_TIMEOUT_MINUTES=15
# Keep legacy timing during the parity observation window. Set to combined_v2 only
# after the seven-day WakaTime comparison passes; rollback is `legacy` plus restart.
DURATION_CALCULATION_MODE=legacy
# Primary display canary. `wakatime_compatible` preserves existing totals;
# `active_v1` selects explicit 15-second human leases plus measured AI tool time
# when coverage is available, while responses continue to include both values.
DURATION_PRIMARY_MODE=wakatime_compatible
# Pause allowance for AI-agent activity, bridged on its own timeline so human and agent
# seconds stay separately attributed. Unset follows IDLE_TIMEOUT_MINUTES, which keeps the
# reported total within 1% of WakaTime. Lower it to stop an unattended agent run from
# billing as continuous work (2 reads ~27% below WakaTime); `0` counts only measured agent
# evidence; `off` disables the split and gives up the attribution with it.
# AGENT_IDLE_TIMEOUT_MINUTES=15

# Managed Kafka / RabbitMQ (plans/plan-kafka-rabbitmq-adoption.md). RabbitMQ job mode is
# available when the API and the dedicated workers are deployed together. Keep both
# ingest modes on direct until K0/K3/K4 staging gates are signed off.
# ATOAXIS_EVENT_BUS_URL=<seed-host>:9092,<seed-host>:9092
# ATOAXIS_EVENT_BUS_SASL_MECHANISM=SCRAM-SHA-256
# ATOAXIS_EVENT_BUS_SASL_USERNAME=<kafka-user>
# ATOAXIS_EVENT_BUS_SASL_PASSWORD=<kafka-password>
# ATOAXIS_EVENT_BUS_TLS=true
# ATOAXIS_JOB_QUEUE_URL=amqps://<user>:<password>@<rabbitmq-host>:5671/<vhost>
# ATOAXIS_INGEST_MODE=direct
# State source used by the ingest request path. Keep `clickhouse` for the
# legacy direct path; `dual` mirrors/compares PostgreSQL during migration and
# `postgres` is required before enabling Kafka mode.
# ATOAXIS_INGEST_STATE_SOURCE=clickhouse
# ATOAXIS_INGEST_KAFKA_COHORT=users:<account-uuid>
# AI usage has an independent rollout from heartbeat ingestion.
# ATOAXIS_AI_USAGE_INGEST_MODE=direct
# ATOAXIS_AI_USAGE_KAFKA_COHORT=users:<account-uuid>
# ATOAXIS_AI_USAGE_REQUIRE_CONTRACT_V2=false
# ATOAXIS_AI_USAGE_KAFKA_BATCH_SIZE=1000
# ATOAXIS_AI_USAGE_KAFKA_BATCH_WAIT_MS=500
# ATOAXIS_AI_USAGE_KAFKA_RETRY_MIN_MS=1000
# ATOAXIS_AI_USAGE_KAFKA_RETRY_MAX_MS=60000
# Kafka consumer health endpoint (the heartbeat-enrichment worker defaults to 8082).
# KAFKA_CONSUMER_HEALTH_HOST=0.0.0.0
# KAFKA_CONSUMER_HEALTH_PORT=8082
# AI_USAGE_CONSUMER_HEALTH_PORT=8084
# AI_SESSION_WORKER_HEALTH_PORT=8085
# AI_USAGE_VERIFIER_HEALTH_PORT=8086
# KAFKA_TEST_URL=<isolated-redpanda-bootstrap>
# ATOAXIS_REPROCESS_MODE=sync
# Keep exports closed until the export-worker and S3 bucket have passed the isolated
# end-to-end gate. Enabling this also requires POSTGRES_URL and ATOAXIS_JOB_QUEUE_URL.
# ATOAXIS_EXPORT_MODE=disabled
# Keep destructive account deletion closed until the dedicated worker and the
# PostgreSQL/ClickHouse/S3/cache e2e gate have passed.
# ATOAXIS_ACCOUNT_DELETION_MODE=disabled
# Job-worker process settings (only read by `cargo run --bin job-worker` / the worker image).
# ATOAXIS_JOB_WORKER_PREFETCH=4
# ATOAXIS_JOB_LEASE_SECONDS=300
# ATOAXIS_JOB_RENEW_SECONDS=60
# ATOAXIS_JOB_SHUTDOWN_SECONDS=30
# ATOAXIS_JOB_WORKER_HEALTH_HOST=0.0.0.0
# ATOAXIS_JOB_WORKER_HEALTH_PORT=8081
# Dedicated workers use separate deployment/container port namespaces. Override
# these values when running multiple worker binaries on the same host.
# ATOAXIS_EXPORT_WORKER_PREFETCH=1
# EXPORT_WORKER_HEALTH_HOST=0.0.0.0
# EXPORT_WORKER_HEALTH_PORT=8082
# ATOAXIS_PROJECTION_WORKER_PREFETCH=2
# PROJECTION_WORKER_HEALTH_HOST=0.0.0.0
# PROJECTION_WORKER_HEALTH_PORT=8086
# ATOAXIS_AI_SESSION_WORKER_PREFETCH=10
# ATOAXIS_ACCOUNT_DELETION_WORKER_PREFETCH=1
# ACCOUNT_DELETION_WORKER_HEALTH_HOST=0.0.0.0
# ACCOUNT_DELETION_WORKER_HEALTH_PORT=8087

# Legacy provider placeholder; Presence v2 reads REDIS_URL above.
ATOAXIS_REDIS_URL=redis://<redis-host>:6379
# Export object store (required only when ATOAXIS_EXPORT_MODE=job).
# ATOAXIS_OBJECT_STORE_S3_ENDPOINT=https://s3.<region>.amazonaws.com
# ATOAXIS_OBJECT_STORE_S3_BUCKET=<s3-bucket>
# ATOAXIS_OBJECT_STORE_S3_REGION=<region>
# ATOAXIS_OBJECT_STORE_S3_ACCESS_KEY=<access-key>
# ATOAXIS_OBJECT_STORE_S3_SECRET_KEY=<secret-key>
# ATOAXIS_OBJECT_STORE_S3_PATH_STYLE=false
ATOAXIS_KMS_KEY_ID=<kms-key-id>

# Exact IPs of trusted reverse proxies; blank ignores X-Forwarded-For.
TRUSTED_PROXY_IPS=
