{
  "platforms": {
    "tiktok": {
      "name": "TikTok Shop",
      "auth_type": "oauth",
      "oauth": {
        "authorize_url": "https://auth.tiktok-shops.com/oauth/authorize",
        "token_url": "https://auth.tiktok-shops.com/api/v2/token",
        "scopes": ["seller.product.basic", "seller.order.info"],
        "state_support": true
      },
      "required_env": ["TIKTOK_APP_KEY", "TIKTOK_APP_SECRET"]
    },
    "shopee": {
      "name": "Shopee",
      "auth_type": "oauth",
      "oauth": {
        "authorize_url": "https://partner.shopeemobile.com/api/v2/shop/auth_partner",
        "token_url": "https://partner.shopeemobile.com/api/v2/auth/token/get",
        "state_support": false,
        "uses_hmac_signature": true,
        "redirect_uri": "https://api.lodashventure.local/api/v1/where_on_sales/gateway/ecommerce/shopee/callback",
        "redirect_suffix_pattern": "/{org_id}/{user_id}"
      },
      "required_env": ["SHOPEE_PARTNER_ID", "SHOPEE_PARTNER_KEY"]
    },
    "lazada": {
      "name": "Lazada",
      "auth_type": "oauth",
      "oauth": {
        "authorize_url": "https://auth.lazada.com/oauth/authorize",
        "token_url": "https://auth.lazada.com/oauth/token",
        "state_support": false,
        "uses_hmac_signature": true,
        "redirect_suffix_pattern": "/{shop_id}-{org_id}-{user_id}"
      },
      "required_env": ["LAZADA_APP_KEY", "LAZADA_APP_SECRET"]
    },
    "amazon": {
      "name": "Amazon SP-API",
      "auth_type": "oauth",
      "oauth": {
        "authorize_url": "https://sellercentral.amazon.com/apps/authorize/consent",
        "token_url": "https://api.amazon.com/auth/o2/token",
        "scopes": ["catalog", "listings", "definitions"],
        "state_support": true
      },
      "required_env": ["AMAZON_APP_ID", "AMAZON_CLIENT_SECRET"]
    },
    "ebay": {
      "name": "eBay",
      "auth_type": "oauth",
      "oauth": {
        "authorize_url": "https://auth.ebay.com/oauth2/authorize",
        "token_url": "https://api.ebay.com/identity/v1/oauth2/token",
        "scopes": ["https://api.ebay.com/oauth/api_scope"],
        "state_support": true
      },
      "required_env": ["EBAY_CLIENT_ID", "EBAY_CLIENT_SECRET"]
    },
    "alibaba": {
      "name": "Alibaba",
      "auth_type": "oauth",
      "oauth": {
        "authorize_url": "https://auth.alibaba.com/oauth/authorize",
        "token_url": "https://auth.alibaba.com/oauth/token",
        "state_support": true
      },
      "required_env": ["ALIBABA_CLIENT_ID", "ALIBABA_CLIENT_SECRET"]
    },
    "aliexpress": {
      "name": "AliExpress",
      "auth_type": "oauth",
      "oauth": {
        "authorize_url": "https://auth.aliexpress.com/oauth/authorize",
        "token_url": "https://auth.aliexpress.com/oauth/token",
        "state_support": true
      },
      "required_env": ["ALIEXPRESS_CLIENT_ID", "ALIEXPRESS_CLIENT_SECRET"]
    },
    "flipkart": {
      "name": "Flipkart",
      "auth_type": "oauth",
      "oauth": {
        "authorize_url": "https://auth.flipkart.com/oauth/authorize",
        "token_url": "https://auth.flipkart.com/oauth/token",
        "state_support": true
      },
      "required_env": ["FLIPKART_CLIENT_ID", "FLIPKART_CLIENT_SECRET"]
    },
    "walmart": {
      "name": "Walmart",
      "auth_type": "oauth",
      "oauth": {
        "authorize_url": "https://auth.walmart.com/oauth/authorize",
        "token_url": "https://auth.walmart.com/oauth/token",
        "state_support": true
      },
      "required_env": ["WALMART_CLIENT_ID", "WALMART_CLIENT_SECRET"]
    },
    "jd": {
      "name": "JD.com",
      "auth_type": "oauth",
      "oauth": {
        "authorize_url": "https://auth.jd.com/oauth/authorize",
        "token_url": "https://auth.jd.com/oauth/token",
        "state_support": true
      },
      "required_env": ["JD_CLIENT_ID", "JD_CLIENT_SECRET"]
    },
    "taobao": {
      "name": "Taobao",
      "auth_type": "oauth",
      "oauth": {
        "authorize_url": "https://auth.taobao.com/oauth/authorize",
        "token_url": "https://auth.taobao.com/oauth/token",
        "state_support": true
      },
      "required_env": ["TAOBAO_CLIENT_ID", "TAOBAO_CLIENT_SECRET"]
    },
    "wix": {
      "name": "Wix",
      "auth_type": "oauth",
      "oauth": {
        "authorize_url": "https://www.wix.com/oauth/authorize",
        "token_url": "https://www.wix.com/oauth/token",
        "state_support": true
      },
      "required_env": ["WIX_CLIENT_ID", "WIX_CLIENT_SECRET"]
    },
    "shopify": {
      "name": "Shopify",
      "auth_type": "oauth",
      "oauth": {
        "authorize_url": "https://{shop_domain}/admin/oauth/authorize",
        "token_url": "https://{shop_domain}/admin/oauth/access_token",
        "scopes": ["read_products", "write_products"],
        "state_support": true,
        "requires_shop_domain": true
      },
      "required_env": ["SHOPIFY_CLIENT_ID", "SHOPIFY_CLIENT_SECRET"]
    },
    "bigcommerce": {
      "name": "BigCommerce",
      "auth_type": "oauth",
      "oauth": {
        "authorize_url": "https://login.bigcommerce.com/oauth2/authorize",
        "token_url": "https://login.bigcommerce.com/oauth2/token",
        "scopes": ["store_v2_products"],
        "state_support": true
      },
      "required_env": ["BIGCOMMERCE_CLIENT_ID", "BIGCOMMERCE_CLIENT_SECRET"]
    },
    "ecwid": {
      "name": "Ecwid",
      "auth_type": "oauth",
      "oauth": {
        "authorize_url": "https://my.ecwid.com/api/oauth/authorize",
        "token_url": "https://my.ecwid.com/api/oauth/token",
        "scopes": ["read_catalog", "update_catalog"],
        "state_support": true
      },
      "required_env": ["ECWID_CLIENT_ID", "ECWID_CLIENT_SECRET"]
    },
    "lineshopping": {
      "name": "LINE Shopping",
      "auth_type": "api_key",
      "api_key": {
        "header_name": "X-API-KEY",
        "required_fields": ["api_key"]
      }
    },
    "rakuten": {
      "name": "Rakuten",
      "auth_type": "api_key",
      "api_key": {
        "query_param": "applicationId",
        "required_fields": ["application_id"]
      }
    },
    "woocommerce": {
      "name": "WooCommerce",
      "auth_type": "credentials",
      "credentials": {
        "auth_method": "basic",
        "required_fields": ["consumer_key", "consumer_secret", "store_url"]
      }
    },
    "medusa": {
      "name": "Medusa",
      "auth_type": "credentials",
      "credentials": {
        "auth_method": "jwt",
        "required_fields": ["api_key", "store_url"],
        "header_name": "x-publishable-api-key"
      }
    },
    "magento": {
      "name": "Magento",
      "auth_type": "credentials",
      "credentials": {
        "auth_method": "token",
        "required_fields": ["username", "password", "store_url"]
      }
    }
  }
}
